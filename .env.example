# JWT secret for the API server (required in production)
JWT_SECRET=swapx-dev-secret-change-in-production

# API server port (default: 3001)
PORT=3001

# Comma-separated frontend URLs allowed by CORS
CLIENT_URL=https://final-swap-x.vercel.app

# Frontend: backend API base URL (no trailing slash). Leave empty in local dev to use Vite proxy.
# VITE_API_URL=https://final-swapx-api.onrender.com
