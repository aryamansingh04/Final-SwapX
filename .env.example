# ─── Frontend (Vercel / local Vite) ─────────────────────────────────────────
# Backend API base URL — required on Vercel, leave empty for local dev (uses Vite proxy)
VITE_API_URL=https://final-swapx-api.onrender.com

# ─── Backend (Render / local API server) ────────────────────────────────────
# Required in production — Render auto-generates this via render.yaml
JWT_SECRET=swapx-dev-secret-change-in-production

# API port (Render sets PORT automatically; default 3001 locally)
PORT=3001

# Optional extra CORS origins (comma-separated). All *.vercel.app URLs are allowed by default.
CLIENT_URL=https://final-swap-x.vercel.app
